# Gmail SMTP Configuration for JobPilot Mark 2
# Instructions:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an "App Password": https://myaccount.google.com/apppasswords
# 3. Paste the 16-character App Password below (NOT your regular Gmail login password)

GMAIL_USER=Your_Email@gmail.com
GMAIL_APP_PASSWORD=enter_your_16_char_app_password
RECIPIENT_EMAIL=yaadav.deepanshu@gmail.com

# Optional SMTP Overrides (defaults to Gmail SSL 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
